{
  "name": "tailwind-vite-docker",
  "version": "1.0.0",
  "homepage": "https://okitomomo.github.io/Mahjong/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:firebase": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.0",
    "fast-check": "^4.3.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "js-cookie": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.2",
    "react-router-hash-link": "^2.4.3",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1"
